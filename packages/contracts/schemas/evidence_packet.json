{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weathergpt.in/schemas/evidence_packet.json",
  "title": "EvidencePacket",
  "description": "Grounded weather data evidence packet supporting an answer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this evidence packet"
    },
    "source": {
      "type": "string",
      "description": "Stable source identifier (e.g., open_meteo.forecast, imd.city_forecast)"
    },
    "authority_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1: Official warning, 2: Official forecast, 3: National model, 4: Global model, 5: Aggregator"
    },
    "provenance": {
      "type": "string",
      "enum": ["live", "live-recorded", "documented-sample", "spec-only", "synthetic"],
      "description": "Provenance of the underlying data"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 issue timestamp"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 start of validity window"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 end of validity window"
    },
    "place": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["id", "name", "lat", "lon"],
      "additionalProperties": true
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variable": { "type": "string" },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": "string" },
          "step": { "type": ["integer", "string", "null"] }
        },
        "required": ["variable", "value", "unit"],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": ["number", "string"] }
      },
      "required": ["type", "value"]
    },
    "attribution": {
      "type": "string",
      "description": "Legal attribution text for data source"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 fetch timestamp"
    }
  },
  "required": [
    "id",
    "source",
    "authority_tier",
    "provenance",
    "issued_at",
    "valid_from",
    "valid_to",
    "place",
    "values",
    "attribution",
    "fetched_at"
  ],
  "additionalProperties": false
}
