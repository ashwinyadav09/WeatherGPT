{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weathergpt.in/schemas/place.json",
  "title": "Place",
  "description": "Geographical location record",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["district", "block", "gp", "village", "station", "point"]
    },
    "names": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Place names keyed by language code (e.g. en, hi)"
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "elevation": { "type": ["number", "null"] },
    "state": { "type": ["string", "null"] },
    "district": { "type": ["string", "null"] }
  },
  "required": ["id", "kind", "names", "lat", "lon"],
  "additionalProperties": false
}
