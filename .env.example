# Copy to .env and fill in values. Never commit real keys. Never paste keys into chat.

# Official data (the IMD key is pending; keep IMD_ENABLED=false until it works)
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_ENABLED=false
FORECAST_PRIMARY=open-meteo

# Alerts (public feeds, no key)
SACHET_FEED_BASE_URL=https://sachet.ndma.gov.in/cap_public_website/rss

# LLM: any OpenAI-compatible provider. Set the ones you have.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_FAST_PROVIDER=groq
LLM_FAST_MODEL=

# Speech and translation
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
SARVAM_API_KEY=

# Optional extra LLM
GEMINI_API_KEY=

# Climate data (optional)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Web Push (generate your own key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# App
ENV=dev
TZ=UTC
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_TOKEN=
DATA_DIR=./data

# Services
DATABASE_URL=postgresql://weathergpt:change-me@db:5432/weathergpt
REDIS_URL=redis://redis:6379/0
